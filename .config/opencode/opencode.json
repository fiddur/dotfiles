{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/nc/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/sse",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    },
    "mixpanel": {
      "type": "remote",
      "url": "https://mcp.mixpanel.com/mcp",
      "oauth": {}
    },
    "nc-admin-master": {
      "type": "local",
      "command": [
        "bash", "-c",
        "cd /home/fiddur/nc/MCP/NCBackend3 && set -a && . .env && set +a && exec pnpm tsx scripts/mcp/admin.ts"
      ],
      "environment": { "APP_ENV": "master" }
    },
    "nc-admin-prod": {
      "type": "local",
      "command": [
        "bash", "-c",
        "cd /home/fiddur/nc/MCP/NCBackend3 && set -a && . .env && set +a && exec pnpm tsx scripts/mcp/admin.ts"
      ],
      "environment": { "APP_ENV": "prod" }
    },
    "nc-datastore-prod": {
      "type": "local",
      "command": [
        "bash", "-c",
        "cd /home/fiddur/nc/SentryHacker/NCBackend3 && set -a && . .env && set +a && exec pnpm tsx scripts/mcp/datastore.ts"
      ],
      "environment": { "APP_ENV": "prod" }
    }
  }
}
